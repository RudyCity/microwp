{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"microwp-alpha-staging",
  "main":"src/index-durable.ts",
  "compatibility_date":"2026-11-04",
  "workers_dev":true,
  "vars":{"MICROWP_STAGING_MODE":"isolated-probe-only","MICROWP_STORAGE_DRIVER":"d1"},
  "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "durable_objects":{"bindings":[{"name":"SITE_DO","class_name":"MicroWPSite"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["MicroWPSite"]}],
  "d1_databases":[{"binding":"DB","database_name":"microwp-alpha-staging-db","database_id":"15f12bf4-2b90-4a1d-beb1-952f073f34a2","migrations_dir":"migrations"}],
  "r2_buckets":[{"binding":"MEDIA","bucket_name":"microwp-alpha-staging-media"}],
  "observability":{"enabled":true}
}
