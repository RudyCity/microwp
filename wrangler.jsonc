{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "microwp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
