{
  "note": "Merge these bindings into wrangler.jsonc AFTER provisioning resources. Never commit secrets.",
  "kv_namespaces": [{ "binding": "PAGE_CACHE", "id": "REPLACE_WITH_KV_ID" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "microwp-media" }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }],
  "vars": { "CACHE_TTL": "120" }
}
