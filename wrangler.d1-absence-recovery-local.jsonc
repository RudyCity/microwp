{
 "$schema":"./node_modules/wrangler/config-schema.json",
 "name":"microwp-d1-absence-recovery-local-only",
 "main":"src/index-durable.ts",
 "compatibility_date":"2026-11-04",
 "workers_dev":false,
 "vars":{"MICROWP_STORAGE_DRIVER":"d1"},
 "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
 "durable_objects":{"bindings":[{"name":"SITE_DO","class_name":"MicroWPSite"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["MicroWPSite"]}],
 "d1_databases":[{"binding":"DB","database_name":"microwp-d1-absence-recovery-local-db","database_id":"00000000-0000-4000-8000-000000000011","migrations_dir":"migrations"}],
 "r2_buckets":[{"binding":"MEDIA","bucket_name":"microwp-d1-absence-recovery-local-media"}],
 "observability":{"enabled":false}
}
