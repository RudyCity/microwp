{
 "$schema":"./node_modules/wrangler/config-schema.json",
 "name":"microwp-wp-cache-editorial-local-only",
 "main":"src/probes/wp-cache-editorial-local.ts",
 "compatibility_date":"2026-11-04",
 "workers_dev":false,
 "vars":{"MICROWP_STORAGE_DRIVER":"d1","MICROWP_WORKER_CACHE_ENABLED":"yes"},
 "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
 "services":[{"binding":"REDIS_WORKER","service":"microwp-worker-cache"}],
 "durable_objects":{"bindings":[{"name":"SITE_DO","class_name":"MicroWPSite"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["MicroWPSite"]}],
 "d1_databases":[{"binding":"DB","database_name":"microwp-wp-cache-editorial-local-db","database_id":"00000000-0000-4000-8000-000000000007","migrations_dir":"migrations"}],
 "r2_buckets":[{"binding":"MEDIA","bucket_name":"microwp-wp-cache-editorial-local-media"}],
 "observability":{"enabled":false}
}
