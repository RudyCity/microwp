{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "microwp-free-public-preview",
  "main": "src/index-free.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "vars": {
    "MICROWP_FREE_PREVIEW_MODE": "disabled"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "microwp-free-preview-local-db",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "migrations_free"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "microwp-free-preview-local-media"
    }
  ],
  "observability": {"enabled": false}
}
