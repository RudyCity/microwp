# For local workerd testing, copy placeholders to .dev.vars and use a unique secret.
# DO NOT commit or share the actual secret.
WP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
WP_PUBLIC_URL=http://127.0.0.1:8796
# Cloudflare Durable Object and R2 are bindings in wrangler config, not credentials here.
# The current public dynamic runtime is intentionally disabled.
